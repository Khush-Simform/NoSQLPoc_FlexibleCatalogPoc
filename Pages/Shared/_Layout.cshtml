<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Flexible Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <a class="brand" href="/">Flexible Catalog</a>
            <nav class="d-flex gap-3 align-items-center">
                <a href="/">Catalog</a>
                <a href="/cart">Cart</a>
                <a href="/swagger" target="_blank" rel="noopener">Swagger</a>
            </nav>
        </div>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container py-3">
            POC · one MongoDB collection, category-specific nested documents, mocked checkout
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
